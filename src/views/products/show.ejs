<%- include('../layout/header') %>

<div class="row justify-content-center">
  <div class="col-lg-9">

    <!-- Mensagem de Sucesso ou Alerta de Atualização Refletida -->
    <% if (msg) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-patch-check-fill fs-4"></i>
          <div>
            <strong>Efeito Refletido na View!</strong> <%= msg %>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="d-flex align-items-center justify-content-between mb-3">
      <a href="/produtos" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Voltar ao Catálogo
      </a>
      <span class="badge bg-info text-dark"><i class="bi bi-window-sidebar"></i> View: show.ejs</span>
    </div>

    <!-- Card Principal do Produto -->
    <div class="card border-0 shadow-sm bg-white mb-4">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div>
          <span class="badge bg-secondary mb-1"><%= produto.categoria %></span>
          <h4 class="card-title mb-0 fw-bold text-dark"><%= produto.nome %></h4>
        </div>
        <span class="text-muted fw-bold">ID #<%= produto.id %></span>
      </div>

      <div class="card-body p-4">
        <!-- Descrição -->
        <h6 class="text-secondary fw-bold small text-uppercase mb-2">Descrição do Item</h6>
        <p class="text-muted fs-6 mb-4">
          <%= produto.descricao || 'Sem descrição cadastrada.' %>
        </p>

        <!-- Indicadores de Domínio Calculados pelo Model -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small fw-bold d-block">PREÇO UNITÁRIO</span>
              <span class="fs-4 fw-bold text-primary"><%= produto.precoFormatado %></span>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small fw-bold d-block">SALDO EM ESTOQUE</span>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="fs-4 fw-bold text-dark"><%= produto.quantidade_estoque %> un.</span>
                <% if (produto.temEstoque()) { %>
                  <span class="badge bg-success">Disponível</span>
                <% } else { %>
                  <span class="badge bg-danger">Esgotado</span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="col-md-4">
            <div class="p-3 bg-light rounded-3 border">
              <span class="text-muted small fw-bold d-block">VALOR TOTAL DO LOTE</span>
              <span class="fs-4 fw-bold text-success"><%= produto.valorTotalEstoqueFormatado %></span>
            </div>
          </div>
        </div>

        <!-- Box Pedagógico Explicando o Desacoplamento do MVC -->
        <div class="alert alert-light border shadow-none mb-4">
          <h6 class="fw-bold text-dark mb-1">
            <i class="bi bi-info-circle text-primary me-1"></i> Evidência do Padrão MVC nesta Tela:
          </h6>
          <p class="small text-muted mb-0">
            A <strong>View</strong> apenas exibe os dados fornecidos pelo <strong>Controller</strong> (<code>ProductController.show</code>). Note que o status de estoque ("Disponível"/"Esgotado") e o cálculo patrimonial (<code><%= produto.valorTotalEstoqueFormatado %></code>) foram computados diretamente pelo método de negócio da entidade <strong>Model</strong> (<code>Product.calcularValorTotalEstoque</code>), mantendo a interface puramente desacoplada da lógica de dados.
          </p>
        </div>

        <!-- Timestamps do Banco SQLite -->
        <div class="row text-muted small border-top pt-3">
          <div class="col-md-6">
            <i class="bi bi-calendar-plus me-1"></i> <strong>Cadastrado em:</strong> <%= produto.criado_em %>
          </div>
          <div class="col-md-6 text-md-end">
            <i class="bi bi-clock-history me-1"></i> <strong>Última atualização:</strong> <%= produto.atualizado_em %>
          </div>
        </div>
      </div>

      <div class="card-footer bg-white border-top py-3 d-flex justify-content-between">
        <a href="/produtos" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i> Catálogo
        </a>

        <div class="d-flex gap-2">
          <a href="/produtos/<%= produto.id %>/editar" class="btn btn-warning text-dark fw-bold">
            <i class="bi bi-pencil"></i> Editar este Produto
          </a>
          <form action="/produtos/<%= produto.id %>/excluir" method="POST" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este produto?');">
            <button type="submit" class="btn btn-outline-danger">
              <i class="bi bi-trash"></i> Excluir
            </button>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('../layout/footer') %>
