<%- include('../layout/header') %>

<!-- Alertas de Feedback da Controller -->
<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i>
    <strong>Sucesso:</strong> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <strong>Aviso:</strong> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Box Explicativo Didático do Padrão MVC -->
<div class="card mb-4 border-0 shadow-sm bg-white">
  <div class="card-body p-3">
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge bg-success"><i class="bi bi-window"></i> Camada VIEW</span>
      <h6 class="mb-0 fw-bold text-dark">Catálogo Geral de Produtos</h6>
    </div>
    <p class="text-muted small mb-0">
      Esta tela é uma <strong>View (EJS)</strong>. Os dados foram buscados pela <strong>Controller</strong> (<code>ProductController.index</code>) diretamente na camada <strong>Model</strong> (<code>ProductRepository.findAll</code>), sem qualquer código SQL ou lógica de banco na interface.
    </p>
  </div>
</div>

<!-- Cards de Métricas do Domínio (Calculadas pelo Model) -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card card-metric bg-white p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small fw-semibold">TOTAL DE PRODUTOS</span>
          <h3 class="fw-bold mb-0 text-primary"><%= totalProdutos %></h3>
        </div>
        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
          <i class="bi bi-box-seam fs-4"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card card-metric bg-white p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small fw-semibold">VALOR TOTAL EM ESTOQUE</span>
          <h3 class="fw-bold mb-0 text-success"><%= valorTotalFormatado %></h3>
        </div>
        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
          <i class="bi bi-currency-dollar fs-4"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card card-metric bg-white p-3">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <span class="text-muted small fw-semibold">ESTADO DO MODEL & BANCO</span>
          <h5 class="fw-bold mb-0 text-dark">SQLite Persistido</h5>
          <span class="badge bg-info text-dark mt-1">Conexão Singleton Ativa</span>
        </div>
        <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
          <i class="bi bi-database-check fs-4"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filtros, Busca e Botão Novo Produto -->
<div class="card border-0 shadow-sm mb-4 bg-white">
  <div class="card-body">
    <form action="/produtos" method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label for="search" class="form-label small fw-bold text-muted">Buscar por Nome / Descrição</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" id="search" name="search" placeholder="Ex: Dell, Teclado..." value="<%= search %>">
        </div>
      </div>

      <div class="col-md-3">
        <label for="categoria" class="form-label small fw-bold text-muted">Filtrar por Categoria</label>
        <select class="form-select" id="categoria" name="categoria">
          <option value="">Todas as Categorias</option>
          <option value="Eletrônicos" <%= categoria === 'Eletrônicos' ? 'selected' : '' %>>Eletrônicos</option>
          <option value="Periféricos" <%= categoria === 'Periféricos' ? 'selected' : '' %>>Periféricos</option>
          <option value="Monitores" <%= categoria === 'Monitores' ? 'selected' : '' %>>Monitores</option>
          <option value="Áudio" <%= categoria === 'Áudio' ? 'selected' : '' %>>Áudio</option>
          <option value="Mobiliário" <%= categoria === 'Mobiliário' ? 'selected' : '' %>>Mobiliário</option>
          <option value="Geral" <%= categoria === 'Geral' ? 'selected' : '' %>>Geral</option>
        </select>
      </div>

      <div class="col-md-2">
        <label for="sortBy" class="form-label small fw-bold text-muted">Ordenar por</label>
        <select class="form-select" id="sortBy" name="sortBy">
          <option value="id" <%= sortBy === 'id' ? 'selected' : '' %>>ID</option>
          <option value="nome" <%= sortBy === 'nome' ? 'selected' : '' %>>Nome</option>
          <option value="preco" <%= sortBy === 'preco' ? 'selected' : '' %>>Preço</option>
          <option value="quantidade_estoque" <%= sortBy === 'quantidade_estoque' ? 'selected' : '' %>>Estoque</option>
        </select>
      </div>

      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="bi bi-funnel"></i> Filtrar
        </button>
        <% if (search || categoria || sortBy !== 'id') { %>
          <a href="/produtos" class="btn btn-outline-secondary" title="Limpar Filtros">
            <i class="bi bi-x-circle"></i>
          </a>
        <% } %>
        <a href="/produtos/novo" class="btn btn-success flex-fill">
          <i class="bi bi-plus-lg"></i> Novo
        </a>
      </div>
    </form>
  </div>
</div>

<!-- Tabela de Produtos -->
<div class="table-responsive bg-white">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-dark">
      <tr>
        <th scope="col" style="width: 60px;">ID</th>
        <th scope="col">Produto</th>
        <th scope="col">Categoria</th>
        <th scope="col" class="text-end">Preço Unitário</th>
        <th scope="col" class="text-center">Estoque</th>
        <th scope="col" class="text-end">Total Estoque</th>
        <th scope="col" class="text-center" style="width: 170px;">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (produtos.length === 0) { %>
        <tr>
          <td colspan="7" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Nenhum produto cadastrado ou correspondente ao filtro aplicado.<br>
            <a href="/produtos/novo" class="btn btn-sm btn-primary mt-3">Cadastrar Primeiro Produto</a>
          </td>
        </tr>
      <% } else { %>
        <% produtos.forEach(p => { %>
          <tr>
            <td class="fw-bold text-muted">#<%= p.id %></td>
            <td>
              <a href="/produtos/<%= p.id %>" class="text-decoration-none fw-bold text-dark d-block">
                <%= p.nome %>
              </a>
              <% if (p.descricao) { %>
                <small class="text-muted d-block text-truncate" style="max-width: 320px;">
                  <%= p.descricao %>
                </small>
              <% } %>
            </td>
            <td>
              <span class="badge bg-light text-dark border">
                <%= p.categoria %>
              </span>
            </td>
            <td class="text-end fw-semibold text-primary">
              <%= p.precoFormatado %>
            </td>
            <td class="text-center">
              <% if (p.quantidade_estoque === 0) { %>
                <span class="badge bg-danger">Esgotado (0)</span>
              <% } else if (p.quantidade_estoque <= 5) { %>
                <span class="badge bg-warning text-dark">Baixo (<%= p.quantidade_estoque %>)</span>
              <% } else { %>
                <span class="badge bg-success"><%= p.quantidade_estoque %> un.</span>
              <% } %>
            </td>
            <td class="text-end fw-bold text-secondary">
              <%= p.valorTotalEstoqueFormatado %>
            </td>
            <td class="text-center">
              <div class="btn-group btn-group-sm" role="group">
                <a href="/produtos/<%= p.id %>" class="btn btn-outline-info" title="Detalhes do Produto">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/produtos/<%= p.id %>/editar" class="btn btn-outline-warning" title="Editar Produto">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/produtos/<%= p.id %>/excluir" method="POST" class="d-inline" onsubmit="return confirm('Deseja realmente excluir o produto \'<%= p.nome %>\' do Model/Banco de dados?');">
                  <button type="submit" class="btn btn-outline-danger" title="Excluir Produto">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../layout/footer') %>
